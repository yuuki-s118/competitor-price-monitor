ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/price_monitor
REDIS_URL=redis://localhost:6379/0

# 本番では必ず上書きする。生成例: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-key-please-override-in-env-file-3f9a2c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# https://webservice.rakuten.co.jp/ でアプリ登録して取得した認証情報(2026年5月以降、両方必須)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# アプリ登録時の Allowed websites に指定したドメイン(Originヘッダーとして送信される)
RAKUTEN_ALLOWED_ORIGIN=https://github.com

# 価格アラート通知メールの送信元(未設定の場合、通知はログに記録されるのみで送信は行われない)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# フロントエンドのオリジンをJSON配列で指定(本番ではデプロイ先のドメインに変更する)
CORS_ORIGINS=["http://localhost:3000"]
